{
  "name": "prompt-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "组合 benchmarks/ 下的 prompt.md 与仓库根的 shared-prompt.md，生成可直接粘贴到 harness 的 prompt",
  "scripts": {
