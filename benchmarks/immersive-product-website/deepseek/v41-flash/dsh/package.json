{
  "name": "nocturne-one",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NOCTURNE ONE — spatial audio headphones launch site",
  "scripts": {
    "dev": "bash scripts/with-node.sh node_modules/vite/bin/vite.js",
    "build": "bash scripts/with-node.sh node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && bash scripts/with-node.sh node_modules/vite/bin/vite.js build",
    "preview": "bash scripts/with-node.sh node_modules/vite/bin/vite.js preview",
    "typecheck": "bash scripts/with-node.sh node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "verify": "bash scripts/with-node.sh scripts/verify.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
