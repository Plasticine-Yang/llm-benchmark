{
  "version": 1,
  "kind": "process",
  "setup": [
    { "run": "pnpm install --frozen-lockfile", "unless": "node_modules" },
    { "run": "pnpm build", "unless": "dist/index.html" }
  ],
  "start": "bash scripts/with-node.sh node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port {port} --strictPort",
  "notes": "按产出自带的 scripts/with-node.sh 调用 node，绕开本机 node 的库校验限制"
}
