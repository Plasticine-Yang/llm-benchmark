{
  "version": 1,
  "kind": "process",
  "setup": [
    { "run": "npm ci", "unless": "node_modules" },
    { "run": "npm run build", "unless": "dist/index.html" }
  ],
  "start": "node_modules/.bin/vite preview --host 127.0.0.1 --port {port} --strictPort",
  "ports": { "app": "auto" },
  "url": "http://127.0.0.1:{port}/"
}
