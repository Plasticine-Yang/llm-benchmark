{
  "version": 1,
  "kind": "process",
  "setup": [
    { "run": "npm ci", "unless": "node_modules" },
    { "run": "npm run build:client", "unless": "dist/client/index.html" },
    { "run": "npm run build:server", "unless": "dist/server/server/index.js" }
  ],
  "start": "node dist/server/server/index.js",
  "readyUrl": "http://127.0.0.1:{port}/api/health",
  "env": { "NODE_ENV": "production" },
  "notes": "生产单进程：Express 读 PORT，同端口托管 dist/client、/api 与 /ws；绕过 npm start 的 NODE_ENV=production 前缀直接运行 node"
}
